# Healthcare-HMS — local infrastructure environment template
# Setup: copy this file to infra/.env and replace the changeme_* values.
#   cp .env.example .env        (bash/zsh)
#   Copy-Item .env.example .env (PowerShell)
# infra/.env is gitignored — never commit real values.

# MySQL (compose service `mysql`)
MYSQL_ROOT_PASSWORD=changeme_root_password
MYSQL_DATABASE=hms_dev
MYSQL_USER=hms
MYSQL_PASSWORD=changeme_app_password

# Redis (compose service `redis`)
REDIS_PASSWORD=changeme_redis_password

# MinIO (compose service `minio`) — local S3-compatible object storage
MINIO_ROOT_USER=hms_minio
MINIO_ROOT_PASSWORD=changeme_minio_password
